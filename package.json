{
  "name": "photodrop",
  "version": "1.1.0",
  "description": "Transfert local de photos depuis smartphone Android vers PC",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "server": "node server-standalone.js",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": [
    "photo-transfer",
    "qr-code",
    "local-network",
    "electron"
  ],
  "author": "infinition",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.infinition.photodrop",
    "productName": "PhotoDrop",
    "copyright": "MIT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server.js",
      "locales/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PhotoDrop"
    }
  }
}
